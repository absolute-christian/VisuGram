SERVER = "https://visugram-api-production.up.railway.app"
POLL_MS = 30_000
REMOTE_LIMIT = 32
DISPLAY_LIMIT = 8
DISPLAY_RECORDS = 120
MAX_RESPONSE = 256 * 1024
NAME_RE = re.compile(r"[a-z][a-z0-9_]{0,31}")
PAYMENT_REQUESTS = ("TL_payments_canPurchaseStore", "TL_payments_sendStarsForm",
                    "TL_payments_sendPaymentForm", "TL_payments_sendStarsFormV2")
GIFT_MUTATIONS = tuple("TL_payments_" + name for name in (
    "saveStarGift", "convertStarGift", "transferStarGift", "updateStarGiftPrice", "upgradeStarGift",
    "sendStarGiftOffer", "resolveStarGiftOffer", "craftStarGift", "toggleStarGiftsPinnedToTop"))

def java_items(values):
    return [values.get(index) for index in range(values.size())] if values is not None else []

def native_bytes(value):
    from android.util import Base64
    from org.telegram.tgnet import SerializedData

    stream = SerializedData()
    try:
        value.serializeToStream(stream)
        return base64.b64decode(str(Base64.encodeToString(stream.toByteArray(), Base64.NO_WRAP)))
    finally:
        stream.cleanup()

def tl_string(value):
    data = str(value or "").encode("utf-8")
    prefix = bytes([len(data)]) if len(data) < 254 else b"\xfe" + len(data).to_bytes(3, "little")
    result = prefix + data
    return result + bytes((-len(result)) % 4)

def tl_int(value):
    return struct.pack("<I", int(value) & 0xffffffff)

def gift_source(gift, serializer=native_bytes):
    name = str(gift.getClass().getSimpleName())
    if name.startswith("TL_starGiftUnique"):
        attributes = []
        for attribute in java_items(gift.attributes):
            kind = str(attribute.getClass().getSimpleName())
            if "OriginalDetails" in kind:
                attributes.append(serializer(attribute))
                continue
            rarity = getattr(attribute, "rarity", None)
            permille = getattr(rarity, "permille", getattr(attribute, "rarity_permille", 0))
            rarities = {"TL_starGiftAttributeRarityUncommon": 0xdbce6389,
                        "TL_starGiftAttributeRarityRare": 0xf08d516b,
                        "TL_starGiftAttributeRarityEpic": 0x78fbf3a8,
                        "TL_starGiftAttributeRarityLegendary": 0xcef7e7a8}
            rarity_name = str(rarity.getClass().getSimpleName()) if rarity is not None else ""
            encoded_rarity = tl_int(rarities[rarity_name]) if rarity_name in rarities else tl_int(0x36437737) + tl_int(permille)
            if kind.startswith("starGiftAttributeModel"):
                data = tl_int(0x565251e2) + tl_int(1 if getattr(attribute, "crafted", False) else 0)
                data += tl_string(attribute.name) + serializer(attribute.document)
            elif kind.startswith("starGiftAttributePattern"):
                data = tl_int(0x4e7085ea) + tl_string(attribute.name) + serializer(attribute.document)
            elif kind.startswith("starGiftAttributeBackdrop"):
                data = tl_int(0x9f2504e4) + tl_string(attribute.name)
                data += b"".join(tl_int(getattr(attribute, key)) for key in (
                    "backdrop_id", "center_color", "edge_color", "pattern_color", "text_color"))
            else:
                raise ApiError("UNSUPPORTED_GIFT")
            attributes.append(data + encoded_rarity)
        if len(attributes) > 16:
            raise ApiError("UNSUPPORTED_GIFT")
        data = tl_int(0x85f0a9cd) + tl_int(0) + struct.pack("<qq", int(gift.id), int(getattr(gift, "gift_id", 0)))
        data += tl_string(gift.title) + tl_string(gift.slug) + tl_int(gift.num)
        data += tl_int(0x1cb5c415) + tl_int(len(attributes)) + b"".join(attributes)
        data += tl_int(gift.availability_issued) + tl_int(gift.availability_total)
    else:
        flags = int(bool(gift.limited)) | (int(bool(gift.sold_out)) << 1)
        title = str(getattr(gift, "title", "") or "")
        flags |= 32 if title else 0
        data = tl_int(0x313a9547) + tl_int(flags) + struct.pack("<q", int(gift.id)) + serializer(gift.sticker)
        data += struct.pack("<q", int(gift.stars))
        if flags & 1:
            data += tl_int(gift.availability_remains) + tl_int(gift.availability_total)
        data += struct.pack("<q", int(gift.convert_stars))
        if flags & 2:
            data += tl_int(gift.first_sale_date) + tl_int(gift.last_sale_date)
        if flags & 32:
            data += tl_string(title)
    result = base64.b64encode(data).decode("ascii")
    if len(result) > 16384:
        raise ApiError("UNSUPPORTED_GIFT")
    return result

def native_stream(encoded):
    from android.util import Base64
    from org.telegram.tgnet import SerializedData

    raw = base64.b64decode(encoded, validate=True)
    if not raw or len(raw) % 4 or len(encoded) > 16384:
        raise ApiError("UNSUPPORTED_GIFT")
    return SerializedData(Base64.decode(encoded, Base64.DEFAULT))

def decode_gift(encoded):
    from org.telegram.tgnet import TLRPC
    from org.telegram.tgnet.tl import TL_stars

    stream = native_stream(encoded)
    try:
        gift = TL_stars.StarGift.TLdeserialize(stream, stream.readInt32(True), False)
        if gift is not None and gift.getDocument() is not None:
            return gift
    except Exception:
        pass
    finally:
        stream.cleanup()
    stream = native_stream(encoded)
    try:
        constructor, flags = stream.readInt32(True) & 0xffffffff, stream.readInt32(True)
        if constructor == 0x313a9547:
            gift = TL_stars.TL_starGift()
            gift.id = stream.readInt64(True)
            gift.sticker = TLRPC.Document.TLdeserialize(stream, stream.readInt32(True), True)
            gift.stars = stream.readInt64(True)
            gift.limited, gift.sold_out = bool(flags & 1), bool(flags & 2)
            if flags & 1:
                gift.availability_remains, gift.availability_total = stream.readInt32(True), stream.readInt32(True)
            if flags & 16:
                stream.readInt64(True)
            gift.convert_stars = stream.readInt64(True)
            if flags & 2:
                gift.first_sale_date, gift.last_sale_date = stream.readInt32(True), stream.readInt32(True)
            if flags & 8:
                gift.upgrade_stars = stream.readInt64(True)
            if flags & 16:
                stream.readInt64(True)
            if flags & 32:
                gift.title = stream.readString(True)
        elif constructor == 0x85f0a9cd:
            gift = TL_stars.TL_starGiftUnique()
            gift.id = stream.readInt64(True)
            gift_id = stream.readInt64(True)
            if hasattr(gift, "gift_id"):
                gift.gift_id = gift_id
            gift.title, gift.slug, gift.num = stream.readString(True), stream.readString(True), stream.readInt32(True)
            if flags & 1:
                gift.owner_id = TLRPC.Peer.TLdeserialize(stream, stream.readInt32(True), True)
            if flags & 2:
                gift.owner_name = stream.readString(True)
            if flags & 4:
                gift.owner_address = stream.readString(True)
            if stream.readInt32(True) & 0xffffffff != 0x1cb5c415:
                raise ApiError("UNSUPPORTED_GIFT")
            count = stream.readInt32(True)
            if count < 0 or count > 16:
                raise ApiError("UNSUPPORTED_GIFT")
            for _ in range(count):
                kind = stream.readInt32(True) & 0xffffffff
                if kind == 0xe0bff26c:
                    gift.attributes.add(TL_stars.StarGiftAttribute.TLdeserialize(stream, kind - 2**32, True))
                    continue
                constructors = {0x565251e2: TL_stars.starGiftAttributeModel,
                                0x4e7085ea: TL_stars.starGiftAttributePattern,
                                0x9f2504e4: TL_stars.starGiftAttributeBackdrop}
                if kind not in constructors:
                    raise ApiError("UNSUPPORTED_GIFT")
                attribute = constructors[kind]()
                if kind == 0x565251e2:
                    crafted = bool(stream.readInt32(True) & 1)
                    if hasattr(attribute, "crafted"):
                        attribute.crafted = crafted
                attribute.name = stream.readString(True)
                if kind == 0x9f2504e4:
                    for key in ("backdrop_id", "center_color", "edge_color", "pattern_color", "text_color"):
                        setattr(attribute, key, stream.readInt32(True))
                else:
                    attribute.document = TLRPC.Document.TLdeserialize(stream, stream.readInt32(True), True)
                rarity_id = stream.readInt32(True) & 0xffffffff
                if rarity_id == 0x36437737:
                    permille = stream.readInt32(True)
                elif rarity_id in (0xdbce6389, 0xf08d516b, 0x78fbf3a8, 0xcef7e7a8):
                    permille = 0
                else:
                    raise ApiError("UNSUPPORTED_GIFT")
                if hasattr(attribute, "rarity"):
                    attribute.rarity = TL_stars.TL_starGiftAttributeRarity()
                    attribute.rarity.permille = permille
                else:
                    attribute.rarity_permille = permille
                gift.attributes.add(attribute)
            gift.availability_issued, gift.availability_total = stream.readInt32(True), stream.readInt32(True)
        else:
            raise ApiError("UNSUPPORTED_GIFT")
        return gift
    finally:
        stream.cleanup()

def gift_payload(gift, recipient, message, anonymous, price, currency, serializer=native_bytes):
    if recipient <= 0 or currency not in ("XTR", "TON") or not re.fullmatch(r"[0-9]{1,18}", str(price)):
        raise ApiError("INVALID_GIFT")
    text = str(message.text or "") if message is not None else ""
    if len(text) > 255:
        raise ApiError("INVALID_MESSAGE")
    return {"recipient_id": str(recipient), "source": gift_source(gift, serializer),
            "slug": str(getattr(gift, "slug", "") or ""), "message": text,
            "message_data": base64.b64encode(serializer(message)).decode("ascii") if text else "",
            "anonymous": bool(anonymous), "price": str(price), "currency": currency}

def validate_gift(record):
    if not isinstance(record, dict):
        raise ValueError("INVALID_GIFT")
    for field in ("id", "sender_id", "recipient_id", "source", "slug", "message", "message_data", "price", "currency"):
        value = record.get(field, "" if field == "message_data" else None)
        if not isinstance(value, str) or len(value) > (16384 if field in ("source", "message_data") else 512):
            raise ValueError("INVALID_GIFT")
    if (not re.fullmatch(r"[0-9]{1,20}", record["sender_id"])
            or not re.fullmatch(r"[1-9][0-9]{0,19}", record["recipient_id"])
            or record["currency"] not in ("XTR", "TON") or not re.fullmatch(r"[0-9]{1,18}", record["price"])
            or type(record.get("date")) is not int or not 0 <= record["date"] < 2**31):
        raise ValueError("INVALID_GIFT")
    return dict(record)

def gift_price(record):
    if record["currency"] == "TON":
        amount = format(Decimal(record["price"]) / 1_000_000_000, ".9f").rstrip("0").rstrip(".")
        return amount + " TON"
    return record["price"] + " ★"

def get_user_config(account):
    return UserConfig.getInstance(account)

def get_messages_controller(account):
    return MessagesController.getInstance(account)

class ApiError(Exception):
    def __init__(self, code):
        self.code = code
        super().__init__(code)

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, request, response, code, message, headers, url):
        return None

def post_json(path, user_id, body, timeout=8):
    request = urllib.request.Request(
        SERVER + path,
        data=json.dumps(body, separators=(",", ":")).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "X-VisuGram-User-Id": user_id,
        },
        method="POST",
    )
    try:
        response = urllib.request.build_opener(NoRedirect).open(request, timeout=timeout)
    except urllib.error.HTTPError as error:
        with error:
            try:
                payload = json.loads(error.read(4096))
                code = payload.get("error", "SERVER_UNAVAILABLE")
            except (ValueError, AttributeError):
                code = "SERVER_UNAVAILABLE"
        raise ApiError(code if isinstance(code, str) else "SERVER_UNAVAILABLE") from error
    with response:
        data = response.read(MAX_RESPONSE + 1)
    if len(data) > MAX_RESPONSE:
        raise ValueError("RESPONSE_TOO_LARGE")
    result = json.loads(data)
    if not isinstance(result, dict):
        raise ValueError("INVALID_RESPONSE")
    return result

def validate_profile(profile):
    if not isinstance(profile, dict):
        raise ValueError("INVALID_PROFILE")
    phone, names = profile.get("phone", ""), profile.get("usernames", [])
    if not isinstance(phone, str) or len(phone) > 32:
        raise ValueError("INVALID_PROFILE")
    if phone and not re.fullmatch(r"888[0-9]{1,8}", re.sub(r"[\s()+-]", "", phone)):
        raise ValueError("INVALID_PROFILE")
    if not isinstance(names, list) or len(names) > 20:
        raise ValueError("INVALID_PROFILE")
    if any(not isinstance(name, str) or not NAME_RE.fullmatch(name) for name in names) or len(set(names)) != len(names):
        raise ValueError("INVALID_PROFILE")
    primary, revision = profile.get("primary", ""), profile.get("revision", 0)
    metadata = profile.get("collectibles", {})
    if not isinstance(primary, str) or (primary and primary not in names):
        raise ValueError("INVALID_PROFILE")
    if type(revision) is not int or revision < 0 or revision > 2**63 - 1:
        raise ValueError("INVALID_PROFILE")
    if not isinstance(metadata, dict) or any(not isinstance(value, dict) for value in metadata.values()):
        raise ValueError("INVALID_PROFILE")
    return {"phone": phone, "usernames": names, "primary": primary,
            "revision": revision, "collectibles": metadata}

def sync_profile(user_id, username, cached):
    result = post_json("/v1/sync", user_id, {
        "telegram_username": username, "cursor": cached.get("cursor", ""),
        "profile_only": True,
    })
    if result.get("unchanged") is True:
        return None
    cursor, count = result.get("cursor"), result.get("gift_count")
    if not isinstance(cursor, str) or type(count) is not int or count < 0:
        raise ValueError("INVALID_RESPONSE")
    return {"cursor": cursor, "profile": validate_profile(result.get("profile")),
            "gift_count": count, "updated_at": int(time.time())}

def parse_names(value):
    names = [line.strip().lstrip("@").lower() for line in re.split(r"[\r\n,]+", value) if line.strip()]
    if len(names) > 20 or any(not NAME_RE.fullmatch(name) for name in names) or len(set(names)) != len(names):
        raise ApiError("INVALID_USERNAME")
    return names

def phone_from_suffix(value):
    value = re.sub(r"[\s()+-]", "", value.strip())
    if not value:
        return ""
    if not re.fullmatch(r"[0-9]{1,8}", value):
        raise ApiError("INVALID_PHONE")
    return "+888" + value

def visible_names(profile, real_main, real_names):
    names = list(dict.fromkeys([name.lower() for name in [real_main, *real_names, *profile["usernames"]] if name]))
    main = profile["primary"] or (names[0] if names else "")
    return main, [name for name in names if name != main]

def reflection_class(class_name):
    clazz = find_class(class_name)
    if clazz is not None and hasattr(clazz, "getDeclaredMethods"):
        return clazz
    try:
        from java.lang import Class
        from org.telegram.messenger import ApplicationLoader

        return Class.forName(class_name, False, ApplicationLoader.applicationContext.getClassLoader())
    except Exception:
        return None

def find_method(class_name, name, arguments):
    clazz = reflection_class(class_name)
    while clazz is not None:
        for method in clazz.getDeclaredMethods():
            types = [str(value.getName()) for value in method.getParameterTypes()]
            if str(method.getName()) == name and types == arguments:
                method.setAccessible(True)
                return method
        clazz = clazz.getSuperclass()
    return None

def gift_dialog(record, viewer):
    if record["sender_id"] == viewer:
        return record["recipient_id"]
    return record["sender_id"] if record["sender_id"] != "0" else viewer

def canonical_message_data(encoded, expected):
    raw = base64.b64decode(encoded, validate=True)
    if len(encoded) > 16384 or not raw or len(raw) % 4:
        raise ValueError("INVALID_MESSAGE_DATA")
    body = raw[4:] if raw[:4] == tl_int(0x751f3146) else raw
    if not body:
        raise ValueError("INVALID_MESSAGE_DATA")
    length, prefix = body[0], 1
    if length == 254:
        if len(body) < 4:
            raise ValueError("INVALID_MESSAGE_DATA")
        length, prefix = int.from_bytes(body[1:4], "little"), 4
    elif length == 255:
        raise ValueError("INVALID_MESSAGE_DATA")
    end = prefix + length
    vector = end + (-end % 4)
    if (vector + 8 > len(body) or body[prefix:end].decode("utf-8") != expected
            or body[vector:vector + 4] != tl_int(0x1cb5c415)
            or int.from_bytes(body[vector + 4:vector + 8], "little") > 256):
        raise ValueError("INVALID_MESSAGE_DATA")
    return tl_int(0x751f3146) + body

def gift_comment(record, issue=None):
    from org.telegram.tgnet import TLRPC

    if not record["message"]:
        return None
    if record.get("message_data"):
        stream = None
        try:
            raw = canonical_message_data(record["message_data"], record["message"])
            stream = native_stream(base64.b64encode(raw).decode("ascii"))
            message = TLRPC.TL_textWithEntities.TLdeserialize(stream, stream.readInt32(True), True)
            if message is not None and str(message.text) == record["message"] and stream.getPosition() == len(raw):
                length = len(record["message"].encode("utf-16-le")) // 2
                if any(int(entity.offset) < 0 or int(entity.length) < 0 or int(entity.offset) + int(entity.length) > length
                       for entity in java_items(message.entities)):
                    raise ValueError("INVALID_MESSAGE_ENTITIES")
                return message
            raise ValueError("INVALID_MESSAGE_DATA")
        except Exception as error:
            if issue is not None:
                issue("Gift comment", type(error).__name__ + ": unsupported formatting; text retained")
        finally:
            if stream is not None:
                stream.cleanup()
    message = TLRPC.TL_textWithEntities()
    message.text = record["message"]
    return message

def native_peer(identifier):
    from org.telegram.tgnet import TLRPC

    peer = TLRPC.TL_peerUser()
    peer.user_id = int(identifier)
    return peer

def clone_user_info(info):
    from android.util import Base64
    from org.telegram.tgnet import SerializedData, TLRPC

    encoded = native_bytes(info)
    if len(encoded) > MAX_RESPONSE:
        raise ValueError("USER_INFO_TOO_LARGE")
    stream = SerializedData(Base64.decode(base64.b64encode(encoded).decode("ascii"), Base64.DEFAULT))
    try:
        return TLRPC.UserFull.TLdeserialize(stream, stream.readInt32(True), True)
    finally:
        stream.cleanup()

def visual_message_id(record):
    digest = hashlib.sha256(record["id"].encode("utf-8")).digest()
    return -0x40000000 - (int.from_bytes(digest[:4], "little") & 0x3fffffff)

def native_saved_gift(record, title, issue=None):
    from org.telegram.tgnet.tl import TL_stars

    gift, message = decode_gift(record["source"]), gift_comment(record, issue)
    if str(gift.getClass().getSimpleName()).startswith("TL_starGiftUnique"):
        gift.owner_id, gift.owner_address, gift.gift_address = None, None, None
        gift.owner_name = title
        if getattr(gift, "resell_amount", None) is not None:
            gift.resell_amount.clear()
        for index in range(gift.attributes.size() - 1, -1, -1):
            if "OriginalDetails" in str(gift.attributes.get(index).getClass().getSimpleName()):
                gift.attributes.remove(index)
        details = TL_stars.starGiftAttributeOriginalDetails()
        details.date, details.recipient_id = record["date"], native_peer(record["recipient_id"])
        if int(record["sender_id"]) > 0 and not record.get("anonymous"):
            details.sender_id, details.flags = native_peer(record["sender_id"]), 1
        if message is not None:
            details.message, details.flags = message, details.flags | 2
        gift.attributes.add(details)
    saved = TL_stars.TL_savedStarGift()
    saved.gift, saved.date, saved.msg_id, saved.flags = gift, record["date"], visual_message_id(record), 8
    saved.name_hidden, saved.unsaved = bool(record.get("anonymous")), bool(record.get("hidden"))
    saved.pinned_to_top = bool(record.get("pinned"))
    if int(record["sender_id"]) > 0:
        saved.from_id, saved.flags = native_peer(record["sender_id"]), saved.flags | 2
    if message is not None:
        saved.message, saved.flags = message, saved.flags | 4
    return saved

def native_gift_message(account, viewer, record, saved):
    from org.telegram.messenger import MessageObject
    from org.telegram.tgnet import TLRPC
    from org.telegram.tgnet.tl import TL_stars

    unique = str(saved.gift.getClass().getSimpleName()).startswith("TL_starGiftUnique")
    action = TLRPC.TL_messageActionStarGiftUnique() if unique else TLRPC.TL_messageActionStarGift()
    action.gift, action.saved = saved.gift, not bool(record.get("hidden"))
    if unique:
        amount = TL_stars.TL_starsTonAmount() if record["currency"] == "TON" else TL_stars.TL_starsAmount()
        amount.amount, amount.nanos = int(record["price"]), 0
        if amount.amount:
            action.resale_amount, action.flags = amount, action.flags | 256
        else:
            action.transferred = True
    else:
        action.message, action.name_hidden = saved.message, saved.name_hidden
        if saved.message is not None:
            action.flags |= 2
    message = TLRPC.TL_messageService()
    message.id, message.local_id, message.date = saved.msg_id, saved.msg_id, record["date"]
    message.dialog_id = int(gift_dialog(record, viewer))
    message.out, message.unread, message.send_state = record["sender_id"] == viewer, False, 0
    message.from_id = native_peer(record["sender_id"] if int(record["sender_id"]) > 0 else viewer)
    message.peer_id = native_peer(record["recipient_id"])
    message.action, message.flags = action, 256 | (2 if message.out else 0)
    result = MessageObject(account, message, True, False)
    result.stableId = saved.msg_id
    if unique:
        card = TLRPC.TL_messageActionStarGift()
        card.gift, card.message, card.saved, card.name_hidden = saved.gift, saved.message, action.saved, saved.name_hidden
        card.gift.sticker = saved.gift.getDocument()
        card.gift_num = int(saved.gift.num)
        card.to_id, card.auction_acquired = native_peer(record["recipient_id"]), message.out
        if saved.message is not None:
            card.flags |= 2
        message.action = card
        result.type, result.contentType = MessageObject.TYPE_GIFT_STARS, 1
    if record["sender_id"] == "0":
        result.messageText = "Anonymous gift" if str(Locale.getDefault().getLanguage()) != "ru" else "Анонимный подарок"
    return result

class GiftDisplayHook(MethodHook):
    def __init__(self, plugin, action):
        self.plugin, self.action = plugin, action

    def before_hooked_method(self, param):
        self.plugin._display_hook(self.action, param, True)

    def after_hooked_method(self, param):
        self.plugin._display_hook(self.action, param, False)

class ProfileBindHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            self.plugin._bind_profile(param)
        except Exception:
            self.plugin._native_error()

class ProfileClickHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if self.plugin._click_profile(param):
                param.setResult(True)
        except Exception:
            self.plugin._native_error()

class AssetClickHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def before_hooked_method(self, param):
        try:
            if self.plugin._click_asset_span(param):
                param.setResult(None)
        except Exception:
            self.plugin._native_error()

class GiftBuyHook(MethodHook):
    def __init__(self, plugin, resale=False):
        self.plugin, self.resale = plugin, resale

    def before_hooked_method(self, param):
        if not self.plugin._visual_enabled():
            return
        param.setResult(None)
        callback = param.args[-1]
        try:
            account = int(get_private_field(param.thisObject, "currentAccount"))
            if self.resale:
                form, gift, recipient = param.args[0], param.args[1], int(param.args[2])
                message, anonymous = (param.args[3], bool(param.args[4])) if len(param.args) == 6 else (None, True)
                price = sum(int(value.amount) for value in java_items(form.invoice.prices))
                currency = "TON" if bool(get_private_field(param.thisObject, "ton")) else "XTR"
            else:
                gift, anonymous, upgraded, recipient, message = param.args[:5]
                if upgraded:
                    raise ApiError("UPGRADE_UNAVAILABLE")
                price, currency = int(gift.stars), "XTR"
            body = gift_payload(gift, int(recipient), message, anonymous, price, currency)
            self.plugin._send_visual(account, body, callback)
        except Exception as error:
            self.plugin._gift_callback(callback, False)
            self.plugin._show_error(getattr(error, "code", "UNSUPPORTED_GIFT"))

class SheetGiftCallback:
    def __init__(self, plugin, sheet):
        self.plugin, self.sheet = plugin, sheet

    def run(self, success, error):
        try:
            get_private_field(self.sheet, "button").setLoading(False)
            if str(success).lower() == "true":
                from org.telegram.messenger import AndroidUtilities

                close = get_private_field(self.sheet, "closeParentSheet")
                if close is not None:
                    close.run()
                AndroidUtilities.hideKeyboard(get_private_field(self.sheet, "messageEdit"))
                self.sheet.dismiss()
        except Exception:
            self.plugin.log("VisuGram gift sheet completion failed.")

class SheetGiftBuyHook(MethodHook):
    def __init__(self, plugin, message_method):
        self.plugin, self.message_method = plugin, message_method

    def before_hooked_method(self, param):
        if not self.plugin._visual_enabled():
            return
        param.setResult(None)
        sheet = param.thisObject
        callback = SheetGiftCallback(self.plugin, sheet)
        try:
            account = int(get_private_field(sheet, "currentAccount"))
            gift = get_private_field(sheet, "starGift")
            if get_private_field(sheet, "upgrade"):
                raise ApiError("UPGRADE_UNAVAILABLE")
            message = self.message_method.invoke(sheet)
            recipient = int(get_private_field(sheet, "dialogId"))
            anonymous = bool(get_private_field(sheet, "anonymous"))
            body = gift_payload(gift, recipient, message, anonymous, int(gift.stars), "XTR")
            self.plugin._send_visual(account, body, callback)
        except Exception as error:
            self.plugin._gift_callback(callback, False)
            self.plugin._show_error(getattr(error, "code", "UNSUPPORTED_GIFT"))

class PremiumGiftHook(MethodHook):
    def __init__(self, plugin, sheet=False):
        self.plugin, self.sheet = plugin, sheet

    def before_hooked_method(self, param):
        if not self.plugin._visual_enabled():
            return
        if self.sheet:
            clazz = param.thisObject.getClass()
            while clazz is not None and str(clazz.getName()) != "org.telegram.ui.Gifts.SendGiftSheet":
                clazz = clazz.getSuperclass()
            if clazz is None or get_private_field(param.thisObject, "premiumTier") is None:
                return
        param.setResult(None)
        try:
            get_private_field(param.thisObject, "button").setLoading(False)
        except Exception:
            pass
        self.plugin._show_error("PREMIUM_UNAVAILABLE")

class GiftBalanceHook(MethodHook):
    def __init__(self, plugin, intro):
        self.plugin, self.intro = plugin, intro

    def after_hooked_method(self, param):
        if not self.plugin._visual_enabled():
            return
        try:
            if self.intro:
                get_private_field(param.thisObject, "starBalanceTextView").setText("∞")
            elif get_private_field(param.thisObject, "starGift") is not None:
                get_private_field(param.thisObject, "button").setSubText(None, False)
        except Exception:
            pass

class GiftConfirmationBalanceHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        if not self.plugin._visual_enabled():
            return
        try:
            account = int(get_private_field(param.thisObject, "currentAccount"))
            if self.plugin._gift_confirmation_scope != (account, get_ident()):
                return
            balance = param.getResult()
            if balance is None:
                return
            clazz = balance.getClass()
            virtual = clazz.newInstance()
            virtual.amount = 8_000_000_000_000_000_000 if str(clazz.getSimpleName()) == "TL_starsTonAmount" else 8_000_000_000
            virtual.nanos = 0
            param.setResult(virtual)
        except Exception as error:
            self.plugin._gift_hook_issue("Gift confirmation balance", type(error).__name__ + ": " + str(error))

class GiftConfirmationHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        try:
            from android_utils import OnClickListener

            button = get_private_field(param.thisObject, "positiveButton")
            listener = get_private_field(get_private_field(button, "mListenerInfo"), "mOnClickListener")
            account = int(get_private_field(param.thisObject, "currentAccount"))
            if listener is None:
                raise ValueError("CONFIRMATION_LISTENER_UNAVAILABLE")

            def clicked(view):
                previous = self.plugin._gift_confirmation_scope
                try:
                    if self.plugin._visual_enabled():
                        self.plugin._gift_confirmation_scope = (account, get_ident())
                    listener.onClick(view)
                finally:
                    self.plugin._gift_confirmation_scope = previous

            button.setOnClickListener(OnClickListener(clicked))
        except Exception as error:
            self.plugin._gift_hook_issue("Gift confirmation button", type(error).__name__ + ": " + str(error))

class VisuGramPlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._generation = 0
        self._loaded, self._foreground = False, False
        self._busy, self._saving, self._snapshots = {}, {}, {}
        self._remote, self._remote_busy = OrderedDict(), {}
        self._native, self._warned = False, False
        self._span_fragments = None
        self._gift_native, self._gift_busy, self._payment_guard = False, {}, False
        self._gift_resale, self._gift_diagnostics = False, []
        self._gift_confirmation_scope = None
        self._gift_page_state, self._gift_page_busy = None, None
        self._display_pages, self._display_lists, self._display_views = OrderedDict(), OrderedDict(), OrderedDict()
        self._display_registry, self._display_suspended = {}, 0
        self._display_profile, self._display_chat = False, False

    def on_plugin_load(self):
        self._generation = getattr(self, "_generation", 0) + 1
        self._loaded, self._foreground = True, True
        self._busy, self._saving, self._snapshots = {}, {}, {}
        self._remote, self._remote_busy = OrderedDict(), {}
        self._native, self._warned = False, False
        self._gift_page_busy = None
        self._gift_confirmation_scope = None
        self._install_native()
        self._install_gifts()
        self._install_display()
        if self.get_setting("visual_gifts", False) and (not self._payment_guard or not self._gift_native):
            self.set_setting("visual_gifts", False)
        self._restart()

    def on_plugin_unload(self):
        self._loaded = False
        self._generation += 1
        self._clear_display()
        self._remote.clear()
        self._snapshots.clear()
        self._rebind_visible()
        if self._span_fragments is not None:
            self._span_fragments.clear()
        self._gift_page_state = None
        self._gift_confirmation_scope = None

    def on_app_event(self, event_type):
        if not getattr(self, "_loaded", False):
            return
        if event_type in (AppEvent.PAUSE, AppEvent.STOP):
            self._foreground = False
            self._generation += 1
        elif event_type in (AppEvent.START, AppEvent.RESUME):
            self._foreground = True
            self._restart()

    def _text(self, english, russian):
        return russian if str(Locale.getDefault().getLanguage()) == "ru" else english

    def _native_error(self):
        if not self._warned:
            self._warned = True
            self.log("VisuGram profile hook is unavailable for this client version.")

    def _install_native(self):
        try:
            bind = find_method("org.telegram.ui.ProfileActivity$ListAdapter", "onBindViewHolder", [
                "androidx.recyclerview.widget.RecyclerView$ViewHolder", "int",
            ])
            click = find_method("org.telegram.ui.ProfileActivity", "processOnClickOrPress", [
                "int", "android.view.View", "float", "float",
            ])
            link = find_method("org.telegram.ui.Components.URLSpanNoUnderline", "onClick", [
                "android.view.View",
            ])
        except Exception:
            self._native_error()
            return
        if bind is None or click is None or link is None:
            self._native_error()
            return
        hooks = []
        try:
            from java.util import WeakHashMap

            self._span_fragments = WeakHashMap()
            hooks.append(self.hook_method(bind, ProfileBindHook(self)))
            hooks.append(self.hook_method(click, ProfileClickHook(self)))
            hooks.append(self.hook_method(link, AssetClickHook(self)))
            if not all(hooks):
                raise ValueError("HOOK_UNAVAILABLE")
            self._native = True
        except Exception:
            for hook in hooks:
                if hook:
                    self.unhook_method(hook)
            self._native_error()

    def _running(self, generation):
        return (self._loaded and self._foreground and generation == self._generation
                and self.get_setting("sync_enabled", False))

    def _visual_enabled(self):
        return self._loaded and self.get_setting("visual_gifts", False)

    def _gift_hook_issue(self, label, detail):
        line = label + ": " + str(detail).replace("\n", " ").replace("\r", " ")[:180]
        if line not in self._gift_diagnostics:
            self._gift_diagnostics = (self._gift_diagnostics + [line])[-12:]
        self.log("VisuGram " + line)

    def _gift_hook(self, label, class_name, name, arguments, handler):
        try:
            method = find_method(class_name, name, arguments)
            if method is None:
                clazz = reflection_class(class_name)
                signatures = []
                while clazz is not None and len(signatures) < 2:
                    for candidate in clazz.getDeclaredMethods():
                        if str(candidate.getName()) == name:
                            types = [str(value.getName()).rsplit(".", 1)[-1] for value in candidate.getParameterTypes()]
                            signatures.append("(" + ", ".join(types) + ")")
                    clazz = clazz.getSuperclass()
                detail = "method not found" if not signatures else "unsupported signature: " + "; ".join(signatures[:2])
                self._gift_hook_issue(label, detail)
                return False
            if not self.hook_method(method, handler):
                self._gift_hook_issue(label, "SDK did not install the hook")
                return False
            return True
        except Exception as error:
            self._gift_hook_issue(label, type(error).__name__ + ": " + str(error))
            return False

    def _install_gifts(self):
        self._gift_native, self._payment_guard, self._gift_resale = False, False, False
        self._gift_diagnostics = []
        try:
            for name in (*PAYMENT_REQUESTS, *GIFT_MUTATIONS):
                self.add_hook(name, match_substring=True)
            self._payment_guard = True
        except Exception as error:
            self._gift_hook_issue("Payment protection", type(error).__name__ + ": " + str(error))
            return
        controller, sheet = "org.telegram.ui.Stars.StarsController", "org.telegram.ui.Gifts.SendGiftSheet"
        buy = self._gift_hook("StarsController.buyStarGift", controller, "buyStarGift", [
            "org.telegram.tgnet.tl.TL_stars$StarGift", "boolean", "boolean", "long",
            "org.telegram.tgnet.TLRPC$TL_textWithEntities", "org.telegram.messenger.Utilities$Callback2",
        ], GiftBuyHook(self))
        if not buy:
            try:
                message = find_method(sheet, "getMessage", [])
                if message is not None:
                    buy = self._gift_hook("SendGiftSheet.buyStarGift", sheet, "buyStarGift", [], SheetGiftBuyHook(self, message))
                else:
                    self._gift_hook_issue("SendGiftSheet.getMessage", "method not found")
            except Exception as error:
                self._gift_hook_issue("SendGiftSheet.getMessage", type(error).__name__ + ": " + str(error))
        premium = self._gift_hook("SendGiftSheet.buyPremiumTier", sheet, "buyPremiumTier", [], PremiumGiftHook(self))
        if not premium:
            premium = self._gift_hook("SendGiftSheet.show", sheet, "show", [], PremiumGiftHook(self, sheet=True))
        resale_base = ["org.telegram.tgnet.TLRPC$TL_payments_paymentFormStarGift", "org.telegram.tgnet.tl.TL_stars$StarGift", "long"]
        for suffix in (["org.telegram.messenger.Utilities$Callback2"], ["org.telegram.tgnet.TLRPC$TL_textWithEntities",
                       "boolean", "org.telegram.messenger.Utilities$Callback2"]):
            ready = self._gift_hook("StarsController.buyResellingGift(" + str(len(resale_base + suffix)) + ")",
                                    controller, "buyResellingGift", resale_base + suffix, GiftBuyHook(self, True))
            self._gift_resale = self._gift_resale or ready
        if self._gift_resale:
            self._gift_diagnostics = [line for line in self._gift_diagnostics if not line.startswith("StarsController.buyResellingGift(")]
        self._gift_native = buy and premium
        balance = self._gift_hook("StarsController.getBalance", controller, "getBalance", [], GiftConfirmationBalanceHook(self))
        confirmation = self._gift_hook("ResaleBuyTransferAlert.show",
            "org.telegram.ui.Stars.StarGiftSheet$ResaleBuyTransferAlert", "show", [], GiftConfirmationHook(self))
        self._gift_resale = self._gift_resale and balance and confirmation
        for class_name, name, args, intro in (
            ("org.telegram.ui.Stars.StarsIntroActivity", "updateBalance", [], True),
            (sheet, "setButtonText", ["boolean"], False),
        ):
            self._gift_hook(name, class_name, name, args, GiftBalanceHook(self, intro))

    def _install_display(self):
        profile, controller = "org.telegram.ui.ProfileActivity", "org.telegram.ui.Stars.StarsController"
        gifts, sheet = controller + "$GiftsList", "org.telegram.ui.Stars.StarGiftSheet"
        installed = {}
        specs = (
            ("profile_rows", profile, "updateRowsIds", []),
            ("profile_resume", profile, "onResume", []),
            ("profile_list", controller, "getProfileGiftsList", ["long", "boolean"]),
            ("profile_load", gifts, "load", []),
            ("profile_reset", gifts, "invalidate", ["boolean"]),
            ("profile_count", controller, "invalidateProfileGifts", ["org.telegram.tgnet.TLRPC$UserFull"]),
            ("gift_notification", "org.telegram.messenger.NotificationCenter", "postNotificationName", ["int", "[Ljava.lang.Object;"]),
            ("chat_resume", "org.telegram.ui.ChatActivity", "onResume", []),
            ("chat_loaded", "org.telegram.ui.ChatActivity", "didReceivedNotification", ["int", "int", "[Ljava.lang.Object;"]),
            ("chat_layout", "org.telegram.ui.Cells.ChatActionCell", "createGiftPremiumLayouts", [
                "java.lang.CharSequence", "java.lang.CharSequence", "java.lang.CharSequence", "java.lang.CharSequence",
                "boolean", "java.lang.CharSequence", "int", "java.lang.CharSequence", "int", "boolean", "boolean"]),
            ("gift_sheet", sheet, "set", ["org.telegram.messenger.MessageObject"]),
            ("gift_sheet", sheet, "set", ["org.telegram.messenger.MessageObject", controller + "$IGiftsList"]),
        )
        for action, clazz, name, arguments in specs:
            ready = self._gift_hook(action, clazz, name, arguments, GiftDisplayHook(self, action))
            installed[action] = installed.get(action, False) or ready
        self._display_profile = all(installed.get(name) for name in (
            "profile_rows", "profile_resume", "profile_list", "profile_load", "profile_reset", "profile_count", "gift_notification"))
        self._display_chat = all(installed.get(name) for name in ("chat_resume", "chat_loaded", "gift_sheet"))

    def _display_enabled(self):
        return self._loaded and self.get_setting("sync_enabled", False) and not self._display_suspended

    def _display_hook(self, action, param, before):
        try:
            if not self._display_enabled():
                return
            if action == "profile_rows" and before:
                self._overlay_profile(param.thisObject)
            elif action in ("profile_resume", "chat_resume") and not before:
                self._display_visible(param.thisObject)
            elif action == "profile_list" and not before and self._display_profile:
                self._merge_gift_list(param.getResult())
            elif action in ("profile_load", "profile_reset") and self._display_profile:
                target = param.thisObject
                if before:
                    binding = self._list_binding(target)
                    if binding is not None:
                        self._restore_gift_list(binding)
                        if action == "profile_load" and bool(target.endReached):
                            page = self._display_pages.get(binding["key"])
                            if page is not None and page.get("next"):
                                self._request_display(binding["key"], True)
                            param.setResult(None)
                else:
                    self._merge_gift_list(target)
            elif action == "profile_count":
                if before:
                    for binding in self._display_views.values():
                        overlay = binding.get("overlay")
                        if overlay is not None and param.args[0] is not None and param.args[0].equals(overlay):
                            param.args[0] = binding["original"]
                            break
                    for binding in self._display_lists.values():
                        self._restore_gift_list(binding)
                    self._display_suspended += 1
            elif action == "gift_notification" and before and self._display_profile:
                from org.telegram.messenger import NotificationCenter

                args = param.args[1]
                if int(param.args[0]) == NotificationCenter.starUserGiftsLoaded and len(args) >= 2:
                    self._merge_gift_list(args[1])
                    self._display_visible()
            elif action == "chat_loaded" and not before and self._display_chat:
                from org.telegram.messenger import NotificationCenter

                if int(param.args[0]) == NotificationCenter.messagesDidLoad:
                    self._display_visible(param.thisObject, more=True)
            elif action == "gift_sheet" and before:
                message = param.args[0]
                account = int(get_private_field(param.thisObject, "currentAccount"))
                entry = self._display_entry(account, int(message.getId())) if message is not None else None
                if entry is not None:
                    user = get_user_config(account).getCurrentUser()
                    if user is not None and str(user.id) == entry[0][1]:
                        param.setResult(param.thisObject)
                        set_private_field(param.thisObject, "dialogId", 0)
                        param.thisObject.set(entry[2], None)
            elif action == "chat_layout" and before:
                message = get_private_field(param.thisObject, "currentMessageObject")
                account = int(get_private_field(param.thisObject, "currentAccount"))
                entry = self._display_entry(account, int(message.getId())) if message is not None else None
                if entry is not None:
                    gift = entry[2].gift
                    if str(gift.getClass().getSimpleName()).startswith("TL_starGiftUnique"):
                        param.args[1] = str(gift.title) + " #" + format(int(gift.num), ",")
                        param.args[7] = self._text("Gift", "Подарок")
                    if entry[1]["sender_id"] == "0":
                        param.args[0] = self._text("Anonymous gift", "Анонимный подарок")
        except Exception as error:
            self._gift_hook_issue(action, type(error).__name__ + ": " + str(error))
        finally:
            if action == "profile_count" and not before and self._display_suspended:
                self._display_suspended -= 1
                if self._display_enabled():
                    for binding in list(self._display_lists.values()):
                        target = binding["ref"].get()
                        if target is not None:
                            self._merge_gift_list(target)

    def _display_key(self, account, direction, owner):
        user = get_user_config(account).getCurrentUser()
        if user is None or int(owner) <= 0:
            return None
        return account, str(user.id), direction, str(owner)

    def _display_page(self, key):
        if key is None or not self._display_enabled():
            return None
        if key not in self._display_pages:
            self._display_pages[key] = {"records": [], "objects": {}, "count": 0, "cursor": "", "next": "", "time": 0, "busy": None}
        self._display_pages.move_to_end(key)
        while len(self._display_pages) > DISPLAY_LIMIT:
            old, state = self._display_pages.popitem(last=False)
            self._retire_display(old)
        self._request_display(key)
        return self._display_pages[key]

    def _request_display(self, key, more=False):
        state, generation = self._display_pages.get(key), self._generation
        if state is None or not self._running(generation):
            return
        if state["busy"] == generation:
            return
        if more:
            if not state["next"] or len(state["records"]) >= DISPLAY_RECORDS:
                return
        elif time.monotonic() - state["time"] < POLL_MS / 1000:
            return
        offset, cursor = (state["next"], state["cursor"]) if more else ("", "")
        state["busy"] = generation
        account, viewer, direction, owner = key
        body = {"direction": direction, "offset": offset, "cursor": cursor}
        body["peer_id" if direction == "chat" else "owner_id"] = owner

        def work():
            try:
                page = post_json("/v1/gifts/page", viewer, body)
                records = page.get("gifts")
                if (not isinstance(records, list) or len(records) > 6 or type(page.get("count")) is not int
                        or not 0 <= page["count"] < 2**31 or not isinstance(page.get("cursor"), str)
                        or not isinstance(page.get("next_offset"), str)):
                    raise ValueError("INVALID_GIFT_PAGE")
                page["gifts"] = [validate_gift(record) for record in records]
                if any((gift_dialog(record, viewer) != owner if direction == "chat" else record["recipient_id"] != owner)
                       for record in page["gifts"]):
                    raise ValueError("INVALID_GIFT_PAGE")
                error = ""
            except (OSError, ValueError, TypeError, ApiError) as failure:
                page, error = None, getattr(failure, "code", "SERVER_UNAVAILABLE")
            run_on_ui_thread(lambda: self._display_finish(key, state, generation, offset, page, error))

        run_on_queue(work, EXTERNAL_NETWORK_QUEUE)

    def _display_finish(self, key, state, generation, offset, page, error):
        if self._display_pages.get(key) is not state or state["busy"] != generation:
            return
        state["busy"] = None
        if not self._running(generation) or self._display_key(key[0], key[2], key[3]) != key:
            return
        state["time"] = time.monotonic()
        if error:
            if error == "GIFT_PAGE_CHANGED":
                state["time"] = 0
                self._request_display(key)
            else:
                self._gift_hook_issue("Gift display request", error)
            return
        same = page["cursor"] == state["cursor"]
        if offset and not same:
            state["time"] = 0
            self._request_display(key)
            return
        if not offset and same and state["records"][:len(page["gifts"])] == page["gifts"]:
            if state["count"] == page["count"]:
                return
            state["count"] = page["count"]
        else:
            records = (state["records"] if offset else []) + page["gifts"]
            records = list({record["id"]: record for record in records}.values())[:DISPLAY_RECORDS]
            retained = {record["id"] for record in records if record in state["records"]}
            self._retire_display(key, views=False)
            state["objects"] = {identifier: value for identifier, value in state["objects"].items() if identifier in retained}
            state.update(records=records, count=page["count"], cursor=page["cursor"], next=page["next_offset"])
            if len(records) >= DISPLAY_RECORDS:
                state["next"] = ""
        self._display_visible()
        for binding in list(self._display_lists.values()):
            target = binding["ref"].get()
            if binding["key"] == key and target is not None:
                self._merge_gift_list(target)
                target.notifyUpdate()

    def _saved_display(self, key, record):
        state = self._display_pages[key]
        if record["id"] not in state["objects"]:
            state["objects"][record["id"]] = native_saved_gift(record, self._text("Visual gift", "Визуальный подарок"), self._gift_hook_issue)
        saved = state["objects"][record["id"]]
        registry_key = key[0], int(saved.msg_id)
        existing = self._display_registry.get(registry_key)
        if existing is not None and existing[1]["id"] != record["id"]:
            raise ValueError("GIFT_ID_COLLISION")
        self._display_registry[registry_key] = key, record, saved
        return saved

    def _display_entry(self, account, message_id):
        user = get_user_config(account).getCurrentUser()
        if user is None:
            return None
        viewer = str(user.id)
        entry = self._display_registry.get((account, message_id))
        if entry is not None and entry[0][1] == viewer:
            return entry
        if message_id > -0x40000000:
            return None
        for key, state in self._display_pages.items():
            if key[:2] == (account, viewer):
                for record in state["records"]:
                    if visual_message_id(record) == message_id:
                        saved = self._saved_display(key, record)
                        return key, record, saved
        return None

    def _list_binding(self, target):
        from java.lang import System

        return self._display_lists.get(int(System.identityHashCode(target)))

    def _restore_gift_list(self, binding):
        target = binding["ref"].get()
        if target is None or not binding.get("augmented"):
            return
        for index in range(target.gifts.size() - 1, -1, -1):
            if int(target.gifts.get(index).msg_id) in binding["ids"]:
                target.gifts.remove(index)
        target.totalCount, target.endReached = binding["count"], binding["end"]
        binding["augmented"] = False

    def _merge_gift_list(self, target):
        from java.lang import System
        from java.lang.ref import WeakReference

        if target is None or not self._display_profile or not self._display_enabled():
            return
        if bool(target.isCollection) or int(get_private_field(target, "craftingGiftId") or 0):
            return
        key = self._display_key(int(target.currentAccount), "received", int(target.dialogId) or str(get_user_config(int(target.currentAccount)).getClientUserId()))
        active = self._profile_context(get_last_fragment())
        visible = active is not None and key is not None and active == (key[0], key[1], key[3])
        page = self._display_page(key) if visible else self._display_pages.get(key)
        if page is None or bool(target.loading):
            return
        identity = int(System.identityHashCode(target))
        binding = self._display_lists.get(identity)
        if binding is None:
            binding = {"ref": WeakReference(target), "key": key, "ids": set(), "augmented": False}
            self._display_lists[identity] = binding
        if binding["key"] != key:
            self._restore_gift_list(binding)
            binding["key"] = key
        self._restore_gift_list(binding)
        binding.update(count=int(target.totalCount), end=bool(target.endReached), ids=set())
        existing = {int(gift.msg_id) for gift in java_items(target.gifts)}
        count = 0
        for record in page["records"]:
            try:
                saved = self._saved_display(key, record)
                unique = str(saved.gift.getClass().getSimpleName()).startswith("TL_starGiftUnique")
                if unique and not target.isInclude_unique():
                    continue
                if not unique:
                    allowed = target.isInclude_upgradable() if saved.gift.upgrade_stars > 0 else (
                        target.isInclude_limited() if saved.gift.limited else target.isInclude_unlimited())
                    if not allowed:
                        continue
                if not (target.isInclude_hidden() if saved.unsaved else target.isInclude_displayed()):
                    continue
                if int(saved.msg_id) in existing:
                    continue
                target.gifts.add(saved)
                binding["ids"].add(int(saved.msg_id))
                count += 1
            except Exception as error:
                self._gift_hook_issue("Profile gift", str(error))
        items = java_items(target.gifts)
        if target.sort_by_date:
            items.sort(key=lambda gift: (not bool(gift.pinned_to_top), -int(gift.date)))
        target.gifts.clear()
        for gift in items:
            target.gifts.add(gift)
        total = count if target.hasFilters() else page["count"]
        target.totalCount = binding["count"] + total
        target.endReached = binding["end"] and not bool(page["next"])
        binding["augmented"] = True
        while len(self._display_lists) > DISPLAY_LIMIT:
            discarded = self._display_lists.popitem(last=False)[1]
            self._restore_gift_list(discarded)

    def _overlay_profile(self, fragment):
        from java.lang import System
        from java.lang.ref import WeakReference

        context = self._profile_context(fragment)
        if not self._display_profile or context is None:
            return
        account, viewer, owner = context
        key = account, viewer, "received", owner
        page = self._display_page(key)
        info = get_private_field(fragment, "userInfo")
        if info is None or page is None:
            return
        identity = int(System.identityHashCode(fragment))
        binding = self._display_views.get(identity)
        if binding is not None and binding.get("overlay") is not None and info.equals(binding["overlay"]):
            original = binding["original"]
        else:
            original = info
        count = int(original.stargifts_count) + page["count"]
        if binding is not None and info.equals(binding.get("overlay")) and int(info.stargifts_count) == count:
            return
        clone = clone_user_info(original)
        if clone is None:
            return
        clone.stargifts_count = count
        set_private_field(fragment, "userInfo", clone)
        assigned = get_private_field(fragment, "userInfo")
        if assigned is None or not assigned.equals(clone):
            raise ValueError("PROFILE_FIELD_UNAVAILABLE")
        self._display_views[identity] = {"ref": WeakReference(fragment), "key": key, "original": original, "overlay": clone}
        layout = get_private_field(fragment, "sharedMediaLayout")
        if layout is not None:
            layout.setUserInfo(clone)
        self._trim_display_views()
        return True

    def _chat_context(self, fragment):
        if fragment is None or str(fragment.getClass().getName()) != "org.telegram.ui.ChatActivity":
            return None
        if (int(get_private_field(fragment, "chatMode") or 0) != 0 or fragment.isThreadChat()
                or get_private_field(fragment, "currentEncryptedChat") is not None):
            return None
        return self._display_key(int(fragment.getCurrentAccount()), "chat", int(fragment.getDialogId()))

    def _display_visible(self, fragment=None, more=False):
        if not self._display_enabled():
            return
        try:
            fragment = fragment or get_last_fragment()
            if self._profile_context(fragment) is not None and self._display_profile:
                changed = self._overlay_profile(fragment)
                if changed:
                    rows = find_method("org.telegram.ui.ProfileActivity", "updateRowsIds", [])
                    if rows is not None:
                        rows.invoke(fragment)
                from org.telegram.ui.Stars import StarsController

                StarsController.getInstance(int(fragment.getCurrentAccount())).getProfileGiftsList(int(fragment.getDialogId()))
                self._rebind_visible()
            elif self._display_chat:
                key = self._chat_context(fragment)
                if key is None:
                    return
                page = self._display_page(key)
                if page is None or bool(get_private_field(fragment, "firstLoading")):
                    return
                self._merge_chat(fragment, key)
                if more and page["next"] and page["records"]:
                    dates = [int(value.messageOwner.date) for value in java_items(fragment.messages)
                             if not value.isDateObject and int(value.getId()) > 0]
                    if dates and min(dates) <= min(record["date"] for record in page["records"]):
                        self._request_display(key, True)
        except Exception as error:
            self._gift_hook_issue("Gift display", type(error).__name__ + ": " + str(error))

    def _remove_chat(self, binding):
        fragment = binding["ref"].get()
        if fragment is None:
            return
        messages = fragment.messages
        dictionaries = get_private_field(fragment, "messagesDict")
        days = get_private_field(fragment, "messagesByDays")
        sorted_days = get_private_field(fragment, "messagesByDaysSorted")
        for value in binding.get("messages", []):
            messages.remove(value)
            if dictionaries is not None and dictionaries[0].get(int(value.getId())) == value:
                dictionaries[0].remove(int(value.getId()))
            group = days.get(value.dateKey) if days is not None else None
            if group is not None:
                group.remove(value)
                if group.isEmpty():
                    days.remove(value.dateKey)
                    sorted_days.remove(int(value.dateKeyInt))
        for header in binding.get("headers", []):
            group = days.get(header.dateKey) if days is not None else None
            if group is None or group.isEmpty():
                messages.remove(header)
        binding["messages"], binding["headers"] = [], []

    def _merge_chat(self, fragment, key):
        from java.lang import System
        from java.lang.ref import WeakReference
        from java.util import ArrayList, Calendar
        from org.telegram.messenger import LocaleController, MessageObject
        from org.telegram.tgnet import TLRPC

        identity = int(System.identityHashCode(fragment))
        binding = self._display_views.get(identity)
        if binding is None:
            binding = {"ref": WeakReference(fragment), "key": key, "messages": [], "headers": []}
            self._display_views[identity] = binding
        page, messages = self._display_pages[key], fragment.messages
        dictionaries = get_private_field(fragment, "messagesDict")
        days = get_private_field(fragment, "messagesByDays")
        sorted_days = get_private_field(fragment, "messagesByDaysSorted")
        adapter = get_private_field(fragment, "chatAdapter")
        if any(value is None for value in (dictionaries, days, sorted_days, adapter)):
            return
        actual = [int(value.messageOwner.date) for value in java_items(messages) if not value.isDateObject and int(value.getId()) > 0]
        oldest = min(actual) if actual else 0
        signature = key, page["cursor"], oldest, tuple(record["id"] for record in page["records"])
        if binding.get("signature") == signature and all(messages.contains(value) for value in binding.get("messages", [])):
            return
        self._remove_chat(binding)
        binding["key"], binding["signature"] = key, signature
        for record in sorted(page["records"], key=lambda item: item["date"], reverse=True):
            if record["date"] < oldest and actual:
                continue
            try:
                saved = self._saved_display(key, record)
                if dictionaries[0].get(int(saved.msg_id)) is not None:
                    continue
                value = native_gift_message(key[0], key[1], record, saved)
                items = java_items(messages)
                position = next((index for index, current in enumerate(items)
                                 if int(current.messageOwner.date) <= record["date"]), len(items))
                messages.add(position, value)
                dictionaries[0].put(int(value.getId()), value)
                group = days.get(value.dateKey)
                if group is None:
                    group = ArrayList()
                    days.put(value.dateKey, group)
                    sorted_days.put(int(value.dateKeyInt), group)
                    date = TLRPC.TL_message()
                    calendar = Calendar.getInstance()
                    calendar.setTimeInMillis(record["date"] * 1000)
                    for field in (Calendar.HOUR_OF_DAY, Calendar.MINUTE, Calendar.SECOND, Calendar.MILLISECOND):
                        calendar.set(field, 0)
                    date.id, date.date = 0, int(calendar.getTimeInMillis() // 1000)
                    date.message = LocaleController.formatDateChat(record["date"])
                    header = MessageObject(key[0], date, False, False)
                    header.type, header.contentType, header.isDateObject = MessageObject.TYPE_DATE, 1, True
                    header.stableId = -int(value.dateKeyInt) - 0x10000000
                    messages.add(position + 1, header)
                    binding["headers"].append(header)
                group.add(value)
                binding["messages"].append(value)
            except Exception as error:
                self._gift_hook_issue("Chat gift", type(error).__name__ + ": " + str(error))
        adapter.updateRowsSafe()
        adapter.notifyDataSetChanged()
        self._trim_display_views()

    def _trim_display_views(self):
        while len(self._display_views) > DISPLAY_LIMIT:
            binding = self._display_views.popitem(last=False)[1]
            self._restore_display_view(binding)

    def _restore_display_view(self, binding):
        fragment = binding["ref"].get()
        if fragment is None:
            return
        if "overlay" in binding:
            info = get_private_field(fragment, "userInfo")
            if info is not None and info.equals(binding["overlay"]):
                set_private_field(fragment, "userInfo", binding["original"])
                layout = get_private_field(fragment, "sharedMediaLayout")
                if layout is not None:
                    layout.setUserInfo(binding["original"])
        else:
            self._remove_chat(binding)
            adapter = get_private_field(fragment, "chatAdapter")
            if adapter is not None:
                adapter.updateRowsSafe()
                adapter.notifyDataSetChanged()

    def _retire_display(self, key, views=True):
        for identity, binding in list(self._display_lists.items()):
            if binding["key"] == key:
                self._restore_gift_list(binding)
                if views:
                    del self._display_lists[identity]
        if views:
            for identity, binding in list(self._display_views.items()):
                if binding["key"] == key:
                    self._restore_display_view(binding)
                    del self._display_views[identity]
        self._display_registry = {identifier: entry for identifier, entry in self._display_registry.items() if entry[0] != key}

    def _clear_display(self):
        for key in list(self._display_pages):
            try:
                self._retire_display(key)
            except Exception as error:
                self._gift_hook_issue("Gift cleanup", str(error))
        self._display_pages.clear()
        self._display_lists.clear()
        self._display_views.clear()
        self._display_registry.clear()

    def _refresh_display(self, account, viewer):
        for key, state in self._display_pages.items():
            if key[:2] == (account, viewer):
                state["time"] = 0
        self._display_visible()

    def _gift_report(self):
        lines = ["VisuGram " + __version__]
        try:
            from org.telegram.messenger import BuildVars

            lines.append("Client " + str(BuildVars.BUILD_VERSION_STRING) + " (" + str(BuildVars.BUILD_VERSION) + ")")
        except Exception:
            pass
        try:
            from _sdk_version import __version__ as sdk_version

            lines.append("SDK " + str(sdk_version))
        except ImportError:
            pass
        for title, ready in ((self._text("Payment protection", "Защита платежей"), self._payment_guard),
                             (self._text("Ordinary gifts", "Обычные подарки"), self._gift_native),
                             (self._text("Collectibles", "Коллекционные"), self._gift_resale and self._gift_native),
                             (self._text("Profile gift grid", "Сетка подарков профиля"), self._display_profile),
                             (self._text("Chat gift cards", "Карточки подарков в чате"), self._display_chat)):
            status = self._text("ready", "готово") if ready else self._text("unavailable", "недоступно")
            lines.append(title + ": " + status)
        account = int(UserConfig.selectedAccount)
        user = get_user_config(account).getCurrentUser()
        if user is not None:
            viewer = str(user.id)
            pages = [state for key, state in self._display_pages.items() if key[:2] == (account, viewer)]
            grid = sum(len(binding["ids"]) for binding in self._display_lists.values() if binding["key"][:2] == (account, viewer))
            cards = sum(len(binding.get("messages", [])) for binding in self._display_views.values() if binding["key"][:2] == (account, viewer))
            lines.append(self._text("Loaded gift records: ", "Загружено записей подарков: ") + str(sum(len(page["records"]) for page in pages)))
            lines.append(self._text("Applied to grid: ", "Добавлено в сетку: ") + str(grid))
            lines.append(self._text("Applied to chat: ", "Добавлено в чат: ") + str(cards))
        lines.extend(self._gift_diagnostics[:12])
        return "\n".join(lines)

    def _show_gift_report(self):
        fragment = get_last_fragment()
        if fragment is None or fragment.getParentActivity() is None:
            self._show_error("GIFT_HOOK_UNAVAILABLE")
            return
        dialog = AlertDialogBuilder(fragment.getParentActivity())
        dialog.set_title(self._text("Gift compatibility", "Совместимость подарков"))
        dialog.set_message(self._gift_report())
        dialog.set_positive_button("OK", lambda builder, index: builder.dismiss())
        dialog.show()

    def pre_request_hook(self, request_name, account, request):
        reference = getattr(request, "stargift", None)
        virtual_reference = reference is not None and (
            int(getattr(reference, "msg_id", 0)) < 0 or int(getattr(reference, "saved_id", 0)) < 0)
        protected = any(str(request_name).startswith(name) for name in (*PAYMENT_REQUESTS, *GIFT_MUTATIONS))
        if virtual_reference or (self._visual_enabled() and protected):
            run_on_ui_thread(lambda: self._show_error("REAL_PAYMENT_BLOCKED"))
            return HookResult(strategy=HookStrategy.CANCEL)
        return HookResult()

    def _gift_toggle(self, enabled):
        if enabled and (not self._gift_native or not self._payment_guard):
            self.set_setting("visual_gifts", False, reload_settings=True)
            self._show_gift_report()
            return
        self.set_setting("visual_gifts", bool(enabled), reload_settings=True)

    def _gift_callback(self, callback, success):
        if callback is not None:
            try:
                from java.lang import Boolean

                callback.run(Boolean.valueOf(success), None)
            except Exception:
                self.log("VisuGram gift completion callback failed.")

    def _send_visual(self, account, body, callback):
        generation = self._generation
        user = get_user_config(account).getCurrentUser()
        if not self._running(generation) or user is None:
            self._gift_callback(callback, False)
            self._show_error("SYNC_DISABLED")
            return
        user_id = str(user.id)
        if user_id in self._gift_busy:
            self._gift_callback(callback, False)
            self._show_error("GIFT_BUSY")
            return
        fingerprint = json.dumps(body, sort_keys=True, separators=(",", ":"))
        previous = self.get_setting("gift_operation:" + user_id, {})
        operation = previous.get("id") if isinstance(previous, dict) and previous.get("body") == fingerprint else None
        if not isinstance(operation, str) or not re.fullmatch(r"[A-Za-z0-9-]{16,64}", operation):
            operation = str(uuid.uuid4())
        self.set_setting("gift_operation:" + user_id, {"body": fingerprint, "id": operation})
        payload = dict(body, operation_id=operation)
        self._gift_busy[user_id] = operation

        def work():
            try:
                post_json("/v1/sync", user_id, {"telegram_username": str(user.username or ""), "profile_only": True})
                result = post_json("/v1/gifts", user_id, payload, timeout=20)
                record = validate_gift(result["gift"]) if "gift" in result else None
                if record is None and result.get("local_only") is not True:
                    raise ValueError("INVALID_GIFT")
                error = ""
            except (OSError, ValueError, TypeError, KeyError, ApiError) as failure:
                record, error = None, getattr(failure, "code", "SERVER_UNAVAILABLE")
            run_on_ui_thread(lambda: self._gift_finish(account, user_id, generation, payload, record, error, callback))

        run_on_queue(work, EXTERNAL_NETWORK_QUEUE)

    def _gift_finish(self, account, user_id, generation, body, record, error, callback):
        operation = body["operation_id"]
        if self._gift_busy.get(user_id) == operation:
            del self._gift_busy[user_id]
        user = get_user_config(account).getCurrentUser()
        if not self._running(generation) or user is None or str(user.id) != user_id:
            self._gift_callback(callback, False)
            return
        if error:
            self._gift_callback(callback, False)
            self._show_error(error)
            return
        if record is None:
            local = self.get_setting("local_gifts:" + user_id, [])
            local = [item for item in local if isinstance(item, dict) and item.get("id") != "local:" + operation][-11:]
            record = dict(body, id="local:" + operation, sender_id=user_id, date=int(time.time()),
                          active=True, hidden=False, pinned=False, local_only=True)
            self.set_setting("local_gifts:" + user_id, [record, *local])
            self._show_error("LOCAL_ONLY")
        self.set_setting("gift_operation:" + user_id, {})
        self._gift_page_state = None
        cached = dict(self._cache(user_id))
        if cached:
            cached["cursor"] = ""
            self._snapshots[user_id] = cached
        self._gift_callback(callback, True)
        self._refresh(generation)
        self._refresh_display(account, user_id)
        try:
            from org.telegram.ui import LaunchActivity

            activity = LaunchActivity.instance
            if activity is not None and activity.getFireworksOverlay() is not None:
                activity.getFireworksOverlay().start(True)
        except Exception:
            pass
        BulletinHelper.show_info(self._text("Visual gift sent.", "Визуальный подарок отправлен."))

    def _open_shop(self):
        if not self._gift_native:
            self._show_gift_report()
            return
        if not self._visual_enabled():
            self._show_error("VISUAL_DISABLED")
            return
        if not self._running(self._generation):
            self._show_error("SYNC_DISABLED")
            return
        try:
            from org.telegram.ui.Gifts import GiftSheet

            fragment = get_last_fragment()
            account = int(UserConfig.selectedAccount)
            user = get_user_config(account).getCurrentUser()
            if fragment is not None and user is not None and fragment.getParentActivity() is not None:
                GiftSheet(fragment.getParentActivity(), account, int(user.id), None).show()
        except Exception as error:
            self._gift_hook_issue("GiftSheet.show", type(error).__name__ + ": " + str(error))
            self._show_gift_report()

    def _load_gift_page(self, direction="received", offset="", cursor="", owner=None):
        generation, account = self._generation, int(UserConfig.selectedAccount)
        user = get_user_config(account).getCurrentUser()
        if not self._running(generation) or user is None:
            self._show_error("SYNC_DISABLED")
            return
        if self._gift_page_busy is not None:
            return
        self._gift_page_busy = generation
        user_id = str(user.id)

        def work():
            try:
                result = post_json("/v1/gifts/page", user_id, {"direction": direction, "offset": offset,
                                                             "cursor": cursor, "owner_id": owner or user_id})
                records = result.get("gifts")
                if (not isinstance(records, list) or len(records) > 6 or type(result.get("count")) is not int
                        or not isinstance(result.get("cursor"), str) or not isinstance(result.get("next_offset"), str)):
                    raise ValueError("INVALID_GIFT_PAGE")
                page = dict(result, gifts=[validate_gift(record) for record in records], direction=direction, owner=owner or user_id)
                error = ""
            except (OSError, ValueError, TypeError, ApiError) as failure:
                page, error = None, getattr(failure, "code", "SERVER_UNAVAILABLE")
            run_on_ui_thread(lambda: self._page_finish(account, user_id, generation, page, error))

        run_on_queue(work, EXTERNAL_NETWORK_QUEUE)

    def _page_finish(self, account, user_id, generation, page, error):
        if self._gift_page_busy == generation:
            self._gift_page_busy = None
        user = get_user_config(account).getCurrentUser()
        if not self._running(generation) or user is None or str(user.id) != user_id:
            return
        if error:
            self._show_error(error)
            return
        self._gift_page_state = dict(page, user_id=user_id, account=account)
        self.set_setting("gift_page_loaded", int(time.time()), reload_settings=True)
        selected = get_user_config(int(UserConfig.selectedAccount)).getCurrentUser()
        if selected is not None and str(selected.id) == user_id:
            self._page_dialog(page, user_id)

    def _page_dialog(self, page, user_id):
        fragment = get_last_fragment()
        if fragment is None or fragment.getParentActivity() is None:
            return
        labels = [(record["slug"] or self._text("Gift", "Подарок")) + " · " + gift_price(record)
                  for record in page["gifts"]]
        if page["next_offset"]:
            labels.append(self._text("Next page", "Следующая страница"))
        if not labels:
            BulletinHelper.show_info(self._text("No gifts yet.", "Подарков пока нет."))
            return
        dialog = AlertDialogBuilder(fragment.getParentActivity())
        dialog.set_title(self._text("Visual gifts", "Визуальные подарки") + " · " + str(page["count"]))

        def selected(builder, index):
            builder.dismiss()
            if index < len(page["gifts"]):
                self._gift_actions(page["gifts"][index], user_id)
            else:
                self._load_gift_page(page["direction"], page["next_offset"], page["cursor"], page.get("owner"))

        dialog.set_items(labels, selected)
        dialog.set_negative_button(self._text("Close", "Закрыть"), lambda builder, index: builder.dismiss())
        dialog.show()

    def _gift_actions(self, record, user_id):
        selected = get_user_config(int(UserConfig.selectedAccount)).getCurrentUser()
        if not self._running(self._generation) or selected is None or str(selected.id) != user_id:
            return
        fragment = get_last_fragment()
        if fragment is None or fragment.getParentActivity() is None:
            return
        actions = [(self._text("View gift", "Посмотреть подарок"), None)]
        if record["recipient_id"] == user_id and record.get("active") and not record.get("local_only"):
            if record["slug"]:
                actions.append((self._text("Unpin from profile", "Открепить от профиля") if record.get("pinned") else
                                self._text("Pin to profile", "Закрепить в профиле"), {"pinned": not record.get("pinned", False)}))
                actions.append((self._text("Take off", "Снять") if record.get("worn") else self._text("Wear", "Носить"),
                                {"worn": not record.get("worn", False)}))
            actions.append((self._text("Show in profile", "Показать в профиле") if record.get("hidden") else
                            self._text("Hide from profile", "Скрыть из профиля"), {"hidden": not record.get("hidden", False)}))
        dialog = AlertDialogBuilder(fragment.getParentActivity())
        dialog.set_title(record["slug"] or self._text("Gift", "Подарок"))
        dialog.set_message(gift_price(record) + ("\n" + record["message"] if record["message"] else ""))

        def selected(builder, index):
            builder.dismiss()
            if actions[index][1] is None:
                self._open_gift(record)
            else:
                self._manage_visual(record, actions[index][1])

        dialog.set_items([item[0] for item in actions], selected)
        dialog.set_negative_button(self._text("Close", "Закрыть"), lambda builder, index: builder.dismiss())
        dialog.show()

    def _manage_visual(self, record, change):
        generation, account = self._generation, int(UserConfig.selectedAccount)
        user = get_user_config(account).getCurrentUser()
        if not self._running(generation) or user is None or str(user.id) != record["recipient_id"] or record.get("local_only"):
            self._show_error("NOT_GIFT_OWNER")
            return
        user_id = str(user.id)
        if user_id in self._gift_busy:
            self._show_error("GIFT_BUSY")
            return
        body = dict(change, id=record["id"])
        fingerprint = json.dumps(body, sort_keys=True, separators=(",", ":"))
        previous = self.get_setting("gift_manage:" + user_id, {})
        operation = previous.get("id") if isinstance(previous, dict) and previous.get("body") == fingerprint else None
        if not isinstance(operation, str) or not re.fullmatch(r"[A-Za-z0-9-]{16,64}", operation):
            operation = str(uuid.uuid4())
        self.set_setting("gift_manage:" + user_id, {"id": operation, "body": fingerprint})
        self._gift_busy[user_id] = operation
        body["operation_id"] = operation

        def work():
            try:
                result = post_json("/v1/gifts/manage", user_id, body)
                updated, error = validate_gift(result.get("gift")), ""
            except (OSError, ValueError, TypeError, ApiError) as failure:
                updated, error = None, getattr(failure, "code", "SERVER_UNAVAILABLE")

            def finish():
                if self._gift_busy.get(user_id) == operation:
                    del self._gift_busy[user_id]
                current = get_user_config(account).getCurrentUser()
                if not self._running(generation) or current is None or str(current.id) != user_id:
                    return
                if error:
                    self._show_error(error)
                    return
                self.set_setting("gift_manage:" + user_id, {})
                self._refresh_display(account, user_id)
                self._load_gift_page()
                BulletinHelper.show_info(self._text("Gift updated.", "Подарок обновлён."))

            run_on_ui_thread(finish)

        run_on_queue(work, EXTERNAL_NETWORK_QUEUE)

    def _open_gift(self, record):
        if not self._running(self._generation):
            return
        try:
            from org.telegram.tgnet import TLRPC
            from org.telegram.tgnet.tl import TL_stars
            from org.telegram.ui.Stars import StarGiftSheet

            fragment = get_last_fragment()
            if fragment is None or fragment.getParentActivity() is None:
                return
            gift = decode_gift(record["source"])
            if str(gift.getClass().getSimpleName()).startswith("TL_starGiftUnique"):
                gift.owner_id, gift.owner_address, gift.gift_address = None, None, None
                gift.owner_name = self._text("Visual gift", "Визуальный подарок")
                if getattr(gift, "resell_amount", None) is not None:
                    gift.resell_amount.clear()
            saved = TL_stars.TL_savedStarGift()
            saved.gift, saved.date = gift, record["date"]
            saved.msg_id, saved.flags = -1, 8
            saved.name_hidden = bool(record.get("anonymous"))
            saved.from_id = TLRPC.TL_peerUser()
            saved.from_id.user_id = int(record["sender_id"])
            if int(record["sender_id"]) > 0:
                saved.flags |= 2
            if record["message"]:
                message = gift_comment(record, self._gift_hook_issue)
                saved.message, saved.flags = message, saved.flags | 4
            sheet = StarGiftSheet(fragment.getParentActivity(), int(UserConfig.selectedAccount), 0, fragment.getResourceProvider())
            sheet.set(saved, None)
            sheet.show()
        except Exception:
            self._show_error("UNSUPPORTED_GIFT")

    def _gift_settings(self):
        user = get_user_config(int(UserConfig.selectedAccount)).getCurrentUser()
        fields = [
            Header(text=self._text("Visual gifts", "Визуальные подарки")),
            Switch(key="visual_gifts", default=False, text=self._text("Visual purchases", "Визуальные покупки"),
                   subtext=self._text("Uses the native gift shop. Telegram payments are blocked while enabled.",
                                     "Использует штатный магазин. При включении платежи Telegram блокируются."), on_change=self._gift_toggle),
            Text(text=self._text("Buy a gift for myself", "Купить подарок себе"), on_click=lambda view: self._open_shop()),
            Text(text=self._text("Received gifts — refresh", "Полученные подарки — обновить"),
                 on_click=lambda view: self._load_gift_page()),
            Text(text=self._text("Sent gifts", "Отправленные подарки"),
                 on_click=lambda view: self._load_gift_page("sent")),
            Text(text=self._text("Gift compatibility", "Совместимость подарков"),
                 on_click=lambda view: self._show_gift_report()),
        ]
        page = self._gift_page_state
        if page is not None and user is not None and page["user_id"] == str(user.id):
            fields.append(Header(text=self._text("Gifts", "Подарки") + " · " + str(page["count"])))
            for record in page["gifts"]:
                title = record["slug"] or self._text("Gift", "Подарок")
                text = gift_price(record) + (" · " + record["message"] if record["message"] else "")
                fields.append(Text(text=title, subtext=text, on_click=lambda view, gift=record: self._gift_actions(gift, str(user.id))))
            if page["next_offset"]:
                fields.append(Text(text=self._text("Next page", "Следующая страница"), accent=True,
                                   on_click=lambda view: self._load_gift_page(page["direction"], page["next_offset"], page["cursor"])))
            if not page["gifts"]:
                fields.append(Divider(text=self._text("No gifts yet.", "Подарков пока нет.")))
        if user is not None:
            local = self.get_setting("local_gifts:" + str(user.id), [])
            if isinstance(local, list) and local:
                fields.append(Header(text=self._text("Local gifts", "Локальные подарки")))
                for record in local[:12]:
                    try:
                        record = validate_gift(record)
                    except ValueError:
                        continue
                    fields.append(Text(text=record["slug"] or self._text("Gift", "Подарок"), subtext=gift_price(record),
                                       on_click=lambda view, gift=record: self._open_gift(gift)))
        fields.append(Divider(text=self._text("To give someone a gift, open Gift in their Telegram profile. Automatic upgrades are not available yet.",
                                             "Для дарения открой «Подарок» в профиле Telegram. Автоматическое улучшение пока недоступно.")))
        return fields

    def _restart(self):
        self._generation += 1
        generation = self._generation
        run_on_ui_thread(lambda: self._tick(generation))

    def _toggle(self, enabled):
        self.set_setting("sync_enabled", enabled)
        if not enabled:
            self._remote.clear()
            self._clear_display()
        self._restart()
        self._rebind_visible()

    def _tick(self, generation):
        if not self._running(generation):
            return
        self._refresh(generation)
        try:
            fragment = get_last_fragment()
            if self._native and self._profile_context(fragment) is not None:
                self._profile_for(fragment)
        except Exception:
            self._native_error()
        self._display_visible()
        run_on_ui_thread(lambda: self._tick(generation), POLL_MS)

    def _cache(self, user_id):
        if user_id in self._snapshots:
            return self._snapshots[user_id]
        try:
            value = json.loads(self.get_setting("snapshot:" + user_id, "{}"))
            value["profile"] = validate_profile(value.get("profile"))
            if not isinstance(value.get("cursor"), str) or type(value.get("gift_count")) is not int or value["gift_count"] < 0:
                raise ValueError("INVALID_CACHE")
        except (TypeError, ValueError, AttributeError):
            value = {}
        self._snapshots[user_id] = value
        return value

    def _store(self, user_id, snapshot):
        self._snapshots[user_id] = snapshot
        selected = get_user_config(int(UserConfig.selectedAccount)).getCurrentUser()
        self.set_setting("snapshot:" + user_id, json.dumps(snapshot, ensure_ascii=False, separators=(",", ":")),
                         reload_settings=selected is not None and str(selected.id) == user_id)
        self._rebind_visible()

    def _refresh(self, generation, manual=False):
        if not self._running(generation):
            if manual:
                self._show_error("SYNC_DISABLED")
            return
        account = int(UserConfig.selectedAccount)
        user = get_user_config(account).getCurrentUser()
        if user is None:
            return
        user_id, username = str(user.id), str(user.username or "")
        if user_id in self._busy or user_id in self._saving:
            return
        cached = self._cache(user_id)
        self._busy[user_id] = generation

        def work():
            try:
                snapshot, error = sync_profile(user_id, username, cached), ""
            except (OSError, ValueError, TypeError, ApiError) as failure:
                snapshot, error = None, getattr(failure, "code", "SERVER_UNAVAILABLE")
            run_on_ui_thread(lambda: self._finish(account, user_id, generation, snapshot, error, manual))

        run_on_queue(work, EXTERNAL_NETWORK_QUEUE)

    def _finish(self, account, user_id, generation, snapshot, error, manual):
        if self._busy.get(user_id) == generation:
            del self._busy[user_id]
        if not self._running(generation):
            return
        user = get_user_config(account).getCurrentUser()
        if user is None or str(user.id) != user_id:
            return
        if error:
            if manual:
                self._show_error(error)
            return
        if snapshot is not None:
            previous_cursor = self._cache(user_id).get("cursor")
            self._store(user_id, snapshot)
            if previous_cursor != snapshot["cursor"]:
                self._refresh_display(account, user_id)
            if (self._gift_page_state is not None and self._gift_page_state["user_id"] == user_id
                    and previous_cursor != snapshot["cursor"]):
                self._gift_page_state = None
        if manual:
            BulletinHelper.show_info(self._text("Profile updated.", "Профиль обновлён."))

    def _profile_context(self, fragment):
        if fragment is None or str(fragment.getClass().getName()) != "org.telegram.ui.ProfileActivity":
            return None
        account = int(fragment.getCurrentAccount())
        user = get_user_config(account).getCurrentUser()
        owner = get_private_field(fragment, "userId")
        if user is None or owner is None or int(owner) <= 0:
            return None
        return account, str(user.id), str(owner)

    def _profile_for(self, fragment):
        context = self._profile_context(fragment)
        if context is None:
            return None
        account, viewer, owner = context
        if owner == viewer:
            return self._cache(viewer).get("profile")
        key = viewer, owner
        cached = self._remote.get(key)
        if cached is None or time.monotonic() - cached[0] >= POLL_MS / 1000:
            self._fetch_remote(account, viewer, owner)
        return cached[1] if cached else None

    def _fetch_remote(self, account, viewer, owner):
        key, generation = (viewer, owner), self._generation
        if key in self._remote_busy or len(self._remote_busy) >= 2:
            return
        self._remote_busy[key] = generation

        def work():
            try:
                result = post_json("/v1/profile/view", viewer, {"owner_id": owner, "profile_only": True})
                profile = validate_profile(result.get("profile"))
            except (OSError, ValueError, TypeError, ApiError):
                profile = None
            run_on_ui_thread(lambda: self._remote_finish(account, key, generation, profile))

        run_on_queue(work, EXTERNAL_NETWORK_QUEUE)

    def _remote_finish(self, account, key, generation, profile):
        if self._remote_busy.get(key) == generation:
            del self._remote_busy[key]
        if not self._running(generation):
            return
        user = get_user_config(account).getCurrentUser()
        if user is None or str(user.id) != key[0]:
            return
        previous = self._remote.pop(key, None)
        self._remote[key] = time.monotonic(), profile or (previous[1] if previous else None)
        while len(self._remote) > REMOTE_LIMIT:
            self._remote.popitem(last=False)
        if profile is not None and (previous is None or profile != previous[1]):
            self._rebind_visible()

    def _name_text(self, fragment, names, profile):
        from android.text import SpannableStringBuilder
        from java.lang.ref import WeakReference
        from org.telegram.ui.Components import URLSpanNoUnderline

        text = ", ".join("@" + name for name in names)
        result, offset = SpannableStringBuilder(text), 0
        for name in names:
            value = "@" + name
            if name in profile["usernames"]:
                span = URLSpanNoUnderline("https://fragment.com/username/" + name)
                self._span_fragments.put(span, WeakReference(fragment))
            else:
                span = URLSpanNoUnderline("https://t.me/" + name)
            result.setSpan(span, offset, offset + len(value), 33)
            offset += len(value) + 2
        return result

    def _click_asset_span(self, param):
        if not self._native or not self._running(self._generation):
            return False
        reference = self._span_fragments.get(param.thisObject)
        if reference is None:
            return False
        fragment = reference.get()
        prefix = "https://fragment.com/username/"
        url = str(param.thisObject.getURL())
        if fragment is None or not url.startswith(prefix):
            return False
        name = url[len(prefix):]
        profile = self._profile_for(fragment)
        if profile is None or name not in profile["usernames"]:
            return False
        return self._open_asset(fragment, "username", name)

    def _bind_profile(self, param):
        if not self._native or not self._running(self._generation):
            return
        fragment = get_private_field(param.thisObject, "this$0")
        position, cell = int(param.args[1]), param.args[0].itemView
        phone_row = get_private_field(fragment, "phoneRow")
        name_row = get_private_field(fragment, "usernameRow")
        if position not in (phone_row, name_row):
            return
        profile = self._profile_for(fragment)
        if profile is None:
            return
        if position == phone_row and profile["phone"]:
            cell.textView.setText(profile["phone"])
            cell.valueTextView.setText(self._text("Anonymous Number", "Анонимный номер"))
        elif position == name_row and profile["usernames"]:
            account, viewer, owner = self._profile_context(fragment)
            user = get_messages_controller(account).getUser(int(owner))
            if user is None:
                return
            real_names = [str(user.usernames.get(index).username or "") for index in range(user.usernames.size())
                          if user.usernames.get(index).active]
            main, others = visible_names(profile, str(user.username or ""), real_names)
            if main in profile["usernames"]:
                cell.textView.setText(self._name_text(fragment, [main], profile))
            prefix = self._text("also ", "также ")
            if others:
                from android.text import SpannableStringBuilder
                subtext = SpannableStringBuilder(prefix)
                subtext.append(self._name_text(fragment, others, profile))
            else:
                subtext = self._text("Username", "Имя пользователя")
            cell.valueTextView.setText(subtext)
            cell.setImage(None)

    def _click_profile(self, param):
        if not self._native or not self._running(self._generation):
            return False
        position, fragment = int(param.args[0]), param.thisObject
        if position != get_private_field(fragment, "phoneRow"):
            return False
        profile = self._profile_for(fragment)
        return bool(profile and profile["phone"] and self._open_asset(fragment, "phone", profile["phone"]))

    def _open_asset(self, fragment, kind, value):
        if not self._running(self._generation):
            return False
        profile = self._profile_for(fragment)
        context = self._profile_context(fragment)
        activity = fragment.getParentActivity()
        if profile is None or context is None or activity is None:
            return False
        canonical = re.sub(r"[\s()+-]", "", value) if kind == "phone" else value
        key = "phone:+" + canonical if kind == "phone" else "username:" + value
        metadata = profile["collectibles"].get(key, {})
        url = "https://fragment.com/" + ("number/" + canonical if kind == "phone" else "username/" + value)
        account, viewer, owner = context
        user = get_messages_controller(account).getUser(int(owner))
        if metadata.get("price_kind") == "last_sale" and user is not None:
            try:
                from org.telegram.tgnet.tl import TL_fragment
                from org.telegram.ui import FragmentUsernameBottomSheet

                info = TL_fragment.TL_collectibleInfo()
                info.purchase_date = max(0, min(int(metadata.get("date", 0)), 2**31 - 1))
                info.currency = str(metadata.get("fiat_currency", "USD")) or "USD"
                info.amount = max(0, min(int(metadata.get("fiat_amount", 0)), 2**63 - 1))
                info.crypto_currency = "TON"
                info.crypto_amount = max(0, min(int(metadata.get("crypto_amount", 0)), 2**63 - 1))
                info.url = url
                FragmentUsernameBottomSheet.open(activity, 1 if kind == "phone" else 0, canonical,
                                                user, info, fragment.getResourceProvider())
                return True
            except Exception:
                self._native_error()
        labels = {
            "visual": self._text("Visual purchase", "Визуальная покупка"),
            "asking": self._text("Price on Fragment", "Цена на Fragment"),
            "bid": self._text("Bid on Fragment", "Ставка на Fragment"),
            "last_sale": self._text("Last sale on Fragment", "Последняя продажа на Fragment"),
        }
        try:
            price = Decimal(str(metadata.get("crypto_amount", "0"))) / 1_000_000_000
            amount = f"{price:,.2f} TON" if price.is_finite() and price >= 0 else "—"
        except (ValueError, ArithmeticError):
            amount = "—"
        title = value if kind == "phone" else "@" + value
        message = labels.get(metadata.get("price_kind"), self._text("Visual asset", "Визуальный объект")) + ": " + amount
        dialog = AlertDialogBuilder(activity)
        dialog.set_title(title)
        dialog.set_message(message)
        from org.telegram.messenger import AndroidUtilities
        from org.telegram.messenger.browser import Browser

        def copy(builder, which):
            AndroidUtilities.addToClipboard(value if kind == "phone" else "https://t.me/" + value)
            builder.dismiss()

        def learn(builder, which):
            Browser.openUrl(activity, url)
            builder.dismiss()

        dialog.set_positive_button(self._text("Learn More", "Подробнее"), learn)
        dialog.set_neutral_button(self._text("Copy", "Копировать"), copy)
        dialog.set_negative_button(self._text("Close", "Закрыть"), lambda builder, which: builder.dismiss())
        dialog.show()
        return True

    def _rebind_visible(self):
        try:
            fragment = get_last_fragment()
            if self._profile_context(fragment) is not None:
                adapter = get_private_field(fragment, "listAdapter")
                if adapter is not None:
                    adapter.notifyDataSetChanged()
        except Exception:
            self._native_error()

    def _show_error(self, code):
        messages = {
            "SYNC_DISABLED": ("Enable synchronization first.", "Сначала включи синхронизацию."),
            "VISUAL_DISABLED": ("Enable visual purchases first.", "Сначала включи визуальные покупки."),
            "INVALID_USERNAME": ("One username per line, without spaces or duplicates.", "Один юзернейм на строку, без пробелов и повторов."),
            "INVALID_PHONE": ("Enter 1–8 digits after +888.", "Введи от 1 до 8 цифр после +888."),
            "PHONE_NOT_FOUND": ("This +888 number was not found on Fragment.", "Этот номер +888 не найден на Fragment."),
            "ASSET_TAKEN": ("This asset is already used in VisuGram.", "Этот объект уже занят в VisuGram."),
            "PROFILE_CHANGED": ("Profile changed on another device. Refresh before saving.", "Профиль изменён на другом устройстве. Обнови его перед сохранением."),
            "SOURCE_UNAVAILABLE": ("Fragment is unavailable. Try again later.", "Fragment недоступен. Попробуй позже."),
            "SYNC_REQUIRED": ("Refresh the profile before saving.", "Обнови профиль перед сохранением."),
            "REAL_PAYMENT_BLOCKED": ("Real Telegram payments are blocked in visual mode.", "Настоящие платежи Telegram заблокированы в визуальном режиме."),
            "GIFT_HOOK_UNAVAILABLE": ("Gift integration is unavailable in this client version.", "Интеграция подарков недоступна в этой версии клиента."),
            "UNSUPPORTED_GIFT": ("This gift format is not supported by the installed client.", "Установленный клиент не поддерживает формат этого подарка."),
            "UPGRADE_UNAVAILABLE": ("Turn off automatic gift upgrade. You can buy a collectible in the Collectibles tab.", "Выключи автоматическое улучшение. Коллекционный подарок можно купить во вкладке «Коллекционные»."),
            "PREMIUM_UNAVAILABLE": ("Visual Premium subscriptions are not supported.", "Визуальные подписки Premium не поддерживаются."),
            "GIFT_BUSY": ("Wait for the previous gift operation to finish.", "Дождись завершения предыдущей операции с подарком."),
            "INVALID_GIFT": ("This gift cannot be sent to this recipient.", "Этот подарок нельзя отправить выбранному получателю."),
            "INVALID_MESSAGE": ("Gift comments can contain up to 255 characters.", "Комментарий к подарку может содержать до 255 символов."),
            "LOCAL_ONLY": ("Saved locally: this recipient has not connected to VisuGram yet.", "Сохранено локально: получатель ещё не подключался к VisuGram."),
            "GIFT_LIMIT": ("The account gift limit has been reached.", "Достигнут лимит подарков аккаунта."),
            "GIFT_PAGE_CHANGED": ("The gift list changed. Refresh received or sent gifts.", "Список подарков изменился. Обнови полученные или отправленные подарки."),
            "NOT_GIFT_OWNER": ("Only the recipient can manage this gift.", "Управлять подарком может только получатель."),
            "PIN_LIMIT": ("The profile pin limit has been reached.", "Достигнут лимит закреплённых подарков."),
        }
        english, russian = messages.get(code, ("Server unavailable. Try again later.", "Сервер недоступен. Попробуй позже."))
        BulletinHelper.show_info(self._text(english, russian))

    def _save(self, user_id, account, keys):
        generation = self._generation
        user = get_user_config(account).getCurrentUser()
        if not self._running(generation) or user is None or str(user.id) != user_id:
            self._show_error("SYNC_DISABLED")
            return
        cached = self._cache(user_id)
        if "profile" not in cached:
            self._show_error("SYNC_REQUIRED")
            return
        if user_id in self._saving or user_id in self._busy:
            return
        if self.get_setting("draft_revision:" + user_id, -1) != cached["profile"]["revision"]:
            self._show_error("PROFILE_CHANGED")
            return
        try:
            names = parse_names(str(self.get_setting(keys[0], "")))
            phone = phone_from_suffix(str(self.get_setting(keys[1], "")))
            primary = str(self.get_setting(keys[2], "")).strip().lstrip("@").lower()
            if primary and primary not in names:
                raise ApiError("INVALID_USERNAME")
        except (ApiError, ValueError, TypeError) as failure:
            self._show_error(getattr(failure, "code", "INVALID_USERNAME"))
            return
        body = {"phone": phone, "usernames": names, "primary": primary,
                "revision": cached["profile"]["revision"]}
        fingerprint = json.dumps(body, sort_keys=True, separators=(",", ":"))
        previous = self.get_setting("operation:" + user_id, {})
        operation = previous.get("id") if isinstance(previous, dict) and previous.get("body") == fingerprint else None
        if not isinstance(operation, str) or not re.fullmatch(r"[A-Za-z0-9-]{16,64}", operation):
            operation = str(uuid.uuid4())
        self.set_setting("operation:" + user_id, {"body": fingerprint, "id": operation})
        body["operation_id"] = operation
        self._saving[user_id] = generation

        def work():
            try:
                result = post_json("/v1/profile", user_id, body, timeout=40)
                profile, error = validate_profile(result.get("profile")), ""
            except (OSError, ValueError, TypeError, ApiError) as failure:
                profile, error = None, getattr(failure, "code", "SERVER_UNAVAILABLE")
            run_on_ui_thread(lambda: self._save_finish(account, user_id, generation, profile, error))

        run_on_queue(work, EXTERNAL_NETWORK_QUEUE)

    def _save_finish(self, account, user_id, generation, profile, error):
        if self._saving.get(user_id) == generation:
            del self._saving[user_id]
        if not self._running(generation):
            return
        user = get_user_config(account).getCurrentUser()
        if user is None or str(user.id) != user_id:
            return
        if error:
            self._show_error(error)
            return
        cached = dict(self._cache(user_id))
        cached.update(profile=profile, cursor="", updated_at=int(time.time()))
        self.set_setting("draft_revision:" + user_id, profile["revision"])
        self._store(user_id, cached)
        self._refresh(generation)
        BulletinHelper.show_info(self._text("Visual profile saved.", "Визуальный профиль сохранён."))

    def _reset_draft(self, user_id):
        profile = self._cache(user_id).get("profile", validate_profile({}))
        self.set_setting("draft_names:" + user_id, "\n".join(profile["usernames"]))
        self.set_setting("draft_phone:" + user_id, re.sub(r"[\s()+-]", "", profile["phone"])[3:])
        self.set_setting("draft_primary:" + user_id, profile["primary"])
        self.set_setting("draft_revision:" + user_id, profile["revision"], reload_settings=True)

    def _editor(self):
        account = int(UserConfig.selectedAccount)
        user = get_user_config(account).getCurrentUser()
        if user is None:
            return []
        user_id = str(user.id)
        profile = self._cache(user_id).get("profile", validate_profile({}))
        keys = ["draft_names:" + user_id, "draft_phone:" + user_id, "draft_primary:" + user_id]
        defaults = ["\n".join(profile["usernames"]), re.sub(r"[\s()+-]", "", profile["phone"])[3:], profile["primary"]]
        for key, default in zip(keys, defaults):
            if self.get_setting(key, None) is None:
                self.set_setting(key, default)
        if self.get_setting("draft_revision:" + user_id, None) is None:
            self.set_setting("draft_revision:" + user_id, profile["revision"])
        names_field = (
            EditText(key=keys[0], hint=self._text("@username — one per line", "@username — один на строку"),
                     default=defaults[0], multiline=True, max_length=660)
            if EditText is not None else
            Input(key=keys[0], text=self._text("Visual usernames", "Визуальные юзернеймы"),
                  default=defaults[0].replace("\n", ", "),
                  subtext=self._text("Separate usernames with commas.", "Разделяй юзернеймы запятыми."))
        )
        return [
            Header(text=self._text("Visual profile", "Визуальный профиль")),
            names_field,
            Input(key=keys[1], text=self._text("Phone number +888", "Номер телефона +888"), default=defaults[1],
                  subtext=self._text("Only digits after +888. Empty field removes the visual number.",
                                     "Только цифры после +888. Пустое поле убирает визуальный номер.")),
            Input(key=keys[2], text=self._text("Main visual username", "Основной визуальный юзернейм"), default=defaults[2],
                  subtext=self._text("Choose a name from the list above. Leave empty to keep the Telegram username.",
                                     "Укажи юзернейм из списка выше. Пустое поле сохраняет основной юзернейм Telegram.")),
            Text(text=self._text("Save", "Сохранить"), accent=True,
                 on_click=lambda view: self._save(user_id, account, keys)),
            Text(text=self._text("Reset edits to server profile", "Сбросить изменения к профилю с сервера"),
                 on_click=lambda view: self._reset_draft(user_id)),
            Divider(text=self._text("Changes are shared with VisuGram Desktop.", "Изменения синхронизируются с VisuGram Desktop.")),
        ]

    def create_settings(self):
        user = get_user_config(int(UserConfig.selectedAccount)).getCurrentUser()
        cached = self._cache(str(user.id)) if user is not None else {}
        profile = cached.get("profile", validate_profile({}))
        return [
            Header(text="VisuGram " + __version__),
            Switch(key="sync_enabled", default=False, text=self._text("Synchronization", "Синхронизация"),
                   subtext=self._text("Sends Telegram ID and basic username to the VisuGram server.",
                                      "Передаёт Telegram ID и основной юзернейм серверу VisuGram."), on_change=self._toggle),
            Text(text=self._text("Refresh now", "Обновить сейчас"), on_click=lambda view: self._refresh(self._generation, True)),
            Text(text=self._text("Gift compatibility", "Совместимость подарков"), on_click=lambda view: self._show_gift_report()),
            Text(text=self._text("Edit visual profile", "Изменить визуальный профиль"), create_sub_fragment=self._editor),
            Text(text=self._text("Usernames", "Юзернеймы"), subtext=", ".join("@" + name for name in profile["usernames"]) or "—"),
            Text(text=self._text("Phone number", "Номер телефона"), subtext=profile["phone"] or "—"),
            Text(text=self._text("Visual gifts", "Визуальные подарки"), subtext=str(cached.get("gift_count", 0)),
                 create_sub_fragment=self._gift_settings),
            Text(text=self._text("Profile integration", "Интеграция профиля"),
                 subtext=self._text("Available", "Доступна") if self._native else self._text(
                     "Unsupported client version. Shared profile is available in these settings.",
                     "Версия клиента не поддерживается. Общий профиль доступен в этих настройках.")),
            Text(text=self._text("Gift integration", "Интеграция подарков"),
                 subtext=self._text("Available", "Доступна") if self._gift_native else self._text("Unsupported client version", "Версия клиента не поддерживается")),
            Divider(text=self._text("Preview: shared profiles, visual purchases, profile gift grid and local chat cards.",
                                    "Предварительная версия: общий профиль, визуальные покупки, сетка подарков и локальные карточки в чате.")),
        ]
